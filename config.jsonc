{
	"modules": [
		{
			"type": "title",
			"key": "{icon}",
			"format": "{2}"
		},
		{
			"type": "os",
			"key": "{icon}",
			"format": "{3}"
		},
		{
			"type": "uptime",
			"key": "{icon}"
		},
		{
			"type": "cpu",
			"key": "{icon}",
			"format": "{1}"
		},
		{
			"type": "gpu",
			"key": "{icon}",
			"format": "{2}",
			"driverSpecific": true,
			"detectionMethod": "pci",    
			"temp": false,
			"hideType": "none"
		},
		{
			"type": "kernel",
			"key": "{icon}",
			"format": "{2}"
		},
		{
			"type": "memory",
			"key": "{icon}",
			"format": "{1} / {2}"
		},
		{
			"type": "packages",
			"key": "{icon}"
		},
		{
			"type": "shell",
			"key": "{icon}"
		},
		{
			"type": "terminal",
			"key": "{icon}",
			"format": "{1}"
		},
		{
			"type": "localip",
			"key": "{icon}"
    	},
		{
			"type": "bluetooth",
			"key": "{icon}"
		}
	],
	"logo": {
		"type": "file",
		"source": "~/.config/fastfetch/ubuntu",
		"padding": {
			"top": 0,
			"left": 1,
			"right": 1
		}
	}
}
